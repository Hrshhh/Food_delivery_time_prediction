      "source": [
        "# For every text column: remove leading/trailing spaces, amd return the literal\n",
        "# String 'NaN' (not a real null) into an action np.nan so pandas treats it as missing\n",
        "\n",
        "for col in df.select_dtypes(include='object').columns:\n",
        "\n",
        "  df[col] = df[col].str.strip()\n",
        "  df[col] = df[col].replace('NaN', np.nan)"
      ]
