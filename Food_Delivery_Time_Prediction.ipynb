    {
      "cell_type": "code",
      "execution_count": 69,
      "metadata": {
        "id": "nccoA4lTg-WB"
      },
      "outputs": [],
      "source": [
        "def calculate_series_distance(\n",
        "    lat1_series, lon1_series, lat2_series, lon2_series, miles=False\n",
        "):\n",
        "    \"\"\"Calculates the great-circle (straight-line) distance between two series of\n",
        "\n",
        "    lat/lon points using the Haversine formula. Returns distance in km (or\n",
        "    miles). Turns four raw coordinate columns into one meaningful 'distance'\n",
        "    feature.\n",
        "    \"\"\"\n",
        "    r = 3956 if miles else 6371\n",
        "    lat1, lon1, lat2, lon2 = map(\n",
        "        np.radians, [lat1_series, lon1_series, lat2_series, lon2_series]\n",
        "    )\n",
        "    dlat = lat2 - lat1\n",
        "    dlon = lon2 - lon1\n",
        "    a = np.sin(dlat / 2) ** 2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon / 2) ** 2\n",
        "    c = 2 * np.arcsin(np.sqrt(a))\n",
        "    return c * r"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 70,
      "metadata": {
        "id": "bLqrAOgPZ5TU"
      },
      "outputs": [],
      "source": [
        "df['distance_km']=calculate_series_distance(df['Restaurant_latitude'], df['Restaurant_longitude'], df['Delivery_location_latitude'], df['Delivery_location_longitude'])"
      ]
    },
